{
  "hosting": {
    "public": "admin-portal",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": "api"
      },
      {
        "source": "**",
        "destination": "/login.html"
      }
    ]
  },
  "functions": {
    "source": "backend-api",
    "codebase": "default"
  }
}
