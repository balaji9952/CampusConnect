<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>

    <!-- ═══════════════════════════════════════════════════════════════
         iisnode handler — points to the compiled production entry point
         ═══════════════════════════════════════════════════════════════ -->
    <handlers>
      <add name="iisnode"
           path="dist/index.js"
           verb="*"
           modules="iisnode" />
    </handlers>

    <!-- ═══════════════════════════════════════════════════════════════
         iisnode configuration
         ═══════════════════════════════════════════════════════════════ -->
    <iisnode
      nodeProcessCommandLine="node.exe"
      node_env="production"
      loggingEnabled="true"
      logDirectory="logs\iisnode"
      debuggingEnabled="false"
      devErrorsEnabled="false"
      maxNamedPipeConnectionRetry="100"
      namedPipeConnectionRetryDelay="250"
    />

    <!-- ═══════════════════════════════════════════════════════════════
         URL Rewrite — send all non-file requests through dist/index.js.
         Static files (uploads/, assets/) are served directly by IIS.
         ═══════════════════════════════════════════════════════════════ -->
    <rewrite>
      <rules>

        <!-- Pass Socket.IO WebSocket traffic straight through -->
        <rule name="SocketIO" stopProcessing="true">
          <match url="socket.io/(.*)" />
          <action type="Rewrite" url="dist/index.js" />
        </rule>

        <!-- Serve uploaded files (ticket photos, QR images) directly from disk -->
        <rule name="StaticUploads" stopProcessing="true">
          <match url="^uploads/(.*)" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
          </conditions>
          <action type="None" />
        </rule>

        <!-- Route everything else through Node.js -->
        <rule name="NodeJS" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="dist/index.js" />
        </rule>

      </rules>
    </rewrite>

    <!-- ═══════════════════════════════════════════════════════════════
         Security — block direct access to sensitive directories
         ═══════════════════════════════════════════════════════════════ -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment="iisnode" />
          <add segment="logs" />
          <add segment="prisma" />
          <add segment="src" />
          <add segment=".env" />
          <add segment="firebase-service-account.json" />
          <add segment="backups" />
          <add segment="data_export" />
          <add segment="scratch" />
        </hiddenSegments>
        <!-- Block direct access to sensitive file types -->
        <fileExtensions>
          <add fileExtension=".ts" allowed="false" />
          <add fileExtension=".env" allowed="false" />
          <add fileExtension=".json" allowed="false" />
          <add fileExtension=".log" allowed="false" />
          <add fileExtension=".sql" allowed="false" />
          <add fileExtension=".ps1" allowed="false" />
          <add fileExtension=".prisma" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <!-- ═══════════════════════════════════════════════════════════════
         Static content cache headers for uploaded images
         ═══════════════════════════════════════════════════════════════ -->
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>

  </system.webServer>
</configuration>
