generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model audit_logs {
  id          BigInt   @id @default(autoincrement())
  user_id     String?  @db.VarChar(36)
  user_name   String?  @db.VarChar(150)
  user_role   String?  @db.VarChar(50)
  action      String   @db.VarChar(100)
  entity_type String?  @db.VarChar(50)
  entity_id   String?  @db.VarChar(50)
  old_value   String?  @db.Text
  new_value   String?  @db.Text
  description String?  @db.VarChar(500)
  ip_address  String?  @db.VarChar(45)
  user_agent  String?  @db.VarChar(500)
  created_at  DateTime @default(now())
  users       users?   @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "FK__audit_log__user___72C60C4A")

  @@index([created_at], map: "IX_audit_created")
  @@index([entity_type, entity_id], map: "IX_audit_entity")
  @@index([user_id, created_at], map: "IX_audit_user")
}

model complaint_categories {
  id                   Int       @id @default(autoincrement())
  name                 String    @unique(map: "UQ_complaint_categories_name") @db.VarChar(100)
  description          String?   @db.VarChar(500)
  icon                 String?   @db.VarChar(50)
  routing_type         String    @default("DEPARTMENT_ROUTED") @db.VarChar(50)
  routing_key          String?   @db.VarChar(100)
  sort_order           Int       @default(0)
  sla_response_hours   Int       @default(24)
  sla_escalation_hours Int       @default(48)
  sla_resolution_hours Int       @default(72)
  is_active            Boolean   @default(true)
  created_at           DateTime  @default(now())
  tickets              tickets[]
}

model departments {
  id                                     Int                      @id @default(autoincrement())
  name                                   String                   @unique(map: "UQ_departments_name") @db.VarChar(150)
  code                                   String?                  @db.VarChar(20)
  hod_user_id                            String?                  @db.VarChar(36)
  is_active                              Boolean                  @default(true)
  created_at                             DateTime                 @default(now())
  updated_at                             DateTime                 @default(now())
  users_departments_hod_user_idTousers   users?                   @relation("departments_hod_user_idTousers", fields: [hod_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_departments_hod")
  escalation_assignments                 escalation_assignments[]
  locations                              locations[]
  users_users_department_idTodepartments users[]                  @relation("users_department_idTodepartments")

  @@index([hod_user_id], map: "IX_departments_hod")
}

model escalation_history {
  id            BigInt   @id @default(autoincrement())
  ticket_id     String   @db.VarChar(30)
  from_level    Int      @db.SmallInt
  to_level      Int      @db.SmallInt
  from_assignee String?  @db.VarChar(150)
  to_assignee   String?  @db.VarChar(150)
  reason        String   @db.VarChar(500)
  escalated_by  String?  @db.VarChar(150)
  user_id       String?  @db.VarChar(36)
  escalated_at  DateTime @default(now())
  tickets       tickets  @relation(fields: [ticket_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK__escalatio__ticke__6754599E")
  users         users?   @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "FK__escalatio__user___68487DD7")

  @@index([ticket_id, escalated_at], map: "IX_escalation_ticket")
  @@index([user_id], map: "IX_escalation_history_user")
}

model locations {
  id                       Int                        @id @default(autoincrement())
  name                     String                     @unique(map: "UQ_locations_name") @db.VarChar(100)
  internal_code            String?                    @db.VarChar(50)
  block                    String?                    @db.VarChar(100)
  floor                    String?                    @db.VarChar(20)
  department_id            Int?
  routing_group_id         Int?
  department_source        DepartmentSource           @default(LOCATION)
  category_id              Int
  is_system                Boolean                    @default(false)
  is_active                Boolean                    @default(true)
  created_at               DateTime                   @default(now())
  academic_QR_sublocations academic_QR_sublocations[]
  departments              departments?               @relation(fields: [department_id], references: [id], onUpdate: NoAction, map: "FK__locations__depar__45F365D3")
  location_categories      location_categories        @relation(fields: [category_id], references: [id], onUpdate: NoAction, map: "FK_locations_category")
  routing_groups           routing_groups?            @relation(fields: [routing_group_id], references: [id], onUpdate: NoAction, map: "FK_locations_routing_group")
  qr_codes                 qr_codes[]
  tickets                  tickets[]

  @@index([department_id], map: "IX_locations_department")
  @@index([category_id], map: "IX_locations_category")
  @@index([routing_group_id], map: "IX_locations_routing_group")
}

model location_categories {
  id           Int         @id @default(autoincrement())
  name         String      @unique @db.VarChar(100)
  routing_type String      @db.VarChar(50)
  is_system    Boolean     @default(true)
  sort_order   Int         @default(0)
  is_active    Boolean     @default(true)
  locations    locations[]
}

model routing_groups {
  id                 Int                  @id @default(autoincrement())
  key                String               @unique @db.VarChar(100)
  display_name       String               @db.VarChar(100)
  is_system          Boolean              @default(true)
  is_active          Boolean              @default(true)
  global_assignments global_assignments[]
  locations          locations[]
}

model notifications {
  id              String   @id @db.VarChar(36)
  user_id         String?  @db.VarChar(36)
  title           String   @db.VarChar(255)
  body            String
  type            String   @db.VarChar(50)
  ticket_id       String?  @db.VarChar(30)
  is_read         Boolean  @default(false)
  privileged_only Boolean  @default(false)
  created_at      DateTime @default(now())
  tickets         tickets? @relation(fields: [ticket_id], references: [id], onUpdate: NoAction, map: "FK__notificat__ticke__6D0D32F4")
  users           users?   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK__notificat__user___6C190EBB")

  @@index([user_id, is_read, created_at], map: "IX_notifications_user_unread")
  @@index([ticket_id], map: "IX_notifications_ticket")
}

model qr_codes {
  id                       Int                       @id @default(autoincrement())
  location_id              Int
  sub_location_id          Int?
  qr_token                 String                    @unique(map: "IX_qr_token") @db.VarChar(64)
  qr_image_url             String?                   @db.VarChar(500)
  qr_image_base64          String?                   @db.Text
  is_active                Boolean                   @default(true)
  generated_by             String?                   @db.VarChar(36)
  generated_at             DateTime                  @default(now())
  expires_at               DateTime?
  users                    users?                    @relation(fields: [generated_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK__qr_codes__genera__4D94879B")
  locations                locations                 @relation(fields: [location_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK__qr_codes__locati__4BAC3F29")
  academic_QR_sublocations academic_QR_sublocations? @relation(fields: [sub_location_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_qr_subloc")

  @@index([generated_by], map: "IX_qr_codes_generated_by")
  @@index([location_id], map: "IX_qr_codes_location")
  @@index([sub_location_id], map: "IX_qr_codes_subloc")
}

/// Academic floor sub-locations — represent specific spots within a building/location
/// (e.g., "Room 101", "Lab A", "Staff Room") that have their own QR codes.
model academic_QR_sublocations {
  id          Int        @id @default(autoincrement())
  location_id Int
  name        String     @db.VarChar(100)
  description String?    @db.VarChar(255)
  is_active   Boolean    @default(true)
  created_at  DateTime   @default(now())
  updated_at  DateTime   @default(now())
  locations   locations  @relation(fields: [location_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK__subloc__location")
  qr_codes    qr_codes[]

  @@index([location_id], map: "IX_subloc_location")
}

model ticket_updates {
  id          BigInt   @id @default(autoincrement())
  ticket_id   String   @db.VarChar(30)
  message     String
  update_type String   @default("remark") @db.VarChar(30)
  updated_by  String   @db.VarChar(150)
  user_id     String?  @db.VarChar(36)
  created_at  DateTime @default(now())
  tickets     tickets  @relation(fields: [ticket_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK__ticket_up__ticke__619B8048")
  users       users?   @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "FK__ticket_up__user___6383C8BA")

  @@index([ticket_id, created_at], map: "IX_ticket_updates_ticket")
  @@index([user_id], map: "IX_ticket_updates_user")
}

model tickets {
  id                   String               @id @db.VarChar(30)
  title                String               @db.VarChar(255)
  description          String               @db.VarChar(2000)
  location_id          Int
  location_name        String               @db.VarChar(100)
  category_id          Int
  category_name        String               @db.VarChar(100)
  ticket_type          String               @default("COMPLAINT") @db.VarChar(50)
  priority             Int                  @default(1) @db.SmallInt
  status               Int                  @default(0) @db.SmallInt
  escalation_level     Int                  @default(1) @db.SmallInt
  assigned_to_name     String?              @db.VarChar(150)
  assigned_role        String?              @db.VarChar(100)
  has_photo            Boolean              @default(false)
  photo_url            String?              @db.VarChar(500)
  creator_id           String               @db.VarChar(36)
  creator_name         String               @db.VarChar(150)
  creator_role         String               @db.VarChar(50)
  resolved_at          DateTime?
  closed_at            DateTime?
  created_at           DateTime             @default(now())
  updated_at           DateTime             @default(now())
  is_deleted           Boolean              @default(false)
  deleted_at           DateTime?            @db.Timestamp(3)
  ticket_number        String?              @unique(map: "UQ_ticket_number") @db.VarChar(30)
  escalation_history   escalation_history[]
  notifications        notifications[]
  ticket_assignments   ticket_assignments[]
  ticket_updates       ticket_updates[]
  complaint_categories complaint_categories @relation(fields: [category_id], references: [id], onUpdate: NoAction, map: "FK__tickets__categor__5812160E")
  users                users                @relation(fields: [creator_id], references: [id], onUpdate: NoAction, map: "FK__tickets__creator__5CD6CB2B")
  locations            locations            @relation(fields: [location_id], references: [id], onUpdate: NoAction, map: "FK__tickets__locatio__571DF1D5")

  @@index([category_id], map: "IX_tickets_category")
  @@index([created_at], map: "IX_tickets_created_desc")
  @@index([creator_id], map: "IX_tickets_creator")
  @@index([location_id], map: "IX_tickets_location")
  @@index([status], map: "IX_tickets_status")
}

model users {
  id                                                               String                         @id @db.VarChar(36)
  name                                                             String                         @db.VarChar(150)
  email                                                            String                         @unique(map: "UQ_users_email") @db.VarChar(255)
  password_hash                                                    String                         @db.VarChar(255)
  role                                                             Int                            @db.SmallInt
  department_id                                                    Int?
  roll_no                                                          String?                        @db.VarChar(50)
  program_type                                                     String?                        @db.VarChar(10)
  branch                                                           String?                        @db.VarChar(50)
  study_year                                                       String?                        @db.VarChar(20)
  designation                                                      String?                        @db.VarChar(100)
  avatar_url                                                       String?                        @db.VarChar(500)
  is_active                                                        Boolean                        @default(true)
  last_login_at                                                    DateTime?
  last_google_login                                                DateTime?
  google_sub                                                       String?                        @unique(map: "UQ_users_google_sub") @db.VarChar(255)
  google_email                                                     String?                        @db.VarChar(255)
  auth_provider                                                    String                         @default("LOCAL") @db.VarChar(20)
  created_at                                                       DateTime                       @default(now())
  updated_at                                                       DateTime                       @default(now())
  audit_logs                                                       audit_logs[]
  departments_departments_hod_user_idTousers                       departments[]                  @relation("departments_hod_user_idTousers")
  escalation_assignments                                           escalation_assignments[]
  escalation_history                                               escalation_history[]
  global_assignments                                               global_assignments[]
  notifications                                                    notifications[]
  qr_codes                                                         qr_codes[]
  ticket_assignments_ticket_assignments_assigned_byTousers         ticket_assignments[]           @relation("ticket_assignments_assigner")
  ticket_assignments_ticket_assignments_assigned_to_user_idTousers ticket_assignments[]           @relation("ticket_assignments_assignee")
  ticket_updates                                                   ticket_updates[]
  tickets                                                          tickets[]
  user_fcm_tokens                                                  user_fcm_tokens[]
  user_notification_preferences                                    user_notification_preferences?
  departments_users_department_idTodepartments                     departments?                   @relation("users_department_idTodepartments", fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK__users__departmen__3E52440B")

  @@index([department_id], map: "IX_users_department")
  @@index([email], map: "IX_users_email")
  @@index([role], map: "IX_users_role")
}

model user_fcm_tokens {
  token      String   @id @db.VarChar(500)
  user_id    String   @db.VarChar(36)
  device_id  String?  @db.VarChar(100)
  updated_at DateTime @default(now())
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([device_id])
}

model user_notification_preferences {
  user_id            String   @id @db.VarChar(36)
  ticket_assignments Boolean  @default(true)
  escalations        Boolean  @default(true)
  resolutions        Boolean  @default(true)
  reminders          Boolean  @default(true)
  announcements      Boolean  @default(true)
  updated_at         DateTime @default(now())
  users              users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model global_assignments {
  id               Int            @id @default(autoincrement())
  routing_group_id Int
  user_id          String         @db.VarChar(36)
  /// Which escalation level this assignment is for (null = Level 1 / initial assignment).
  /// For the same routing_group_id there can be one assignment per escalation_level.
  escalation_level Int?           @db.SmallInt
  is_active        Boolean        @default(true)
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt
  routing_groups   routing_groups @relation(fields: [routing_group_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users            users          @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([routing_group_id, escalation_level])
  @@index([routing_group_id, is_active])
  @@index([escalation_level])
  @@index([user_id], map: "IX_global_assignments_user_id")
}

/// Per-department escalation targets for Level 2 and Level 3.
/// Falls back when no global_assignment exists for a ticket's routing_key + escalation_level.
model escalation_assignments {
  id               Int         @id @default(autoincrement())
  department_id    Int
  escalation_level Int         @db.SmallInt
  user_id          String      @db.VarChar(36)
  is_active        Boolean     @default(true)
  created_at       DateTime    @default(now())
  updated_at       DateTime    @updatedAt
  departments      departments @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users            users       @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([department_id, escalation_level])
  @@index([department_id, is_active])
  @@index([escalation_level])
  @@index([user_id], map: "IX_escalation_assignments_user_id")
}

model ticket_assignments {
  id                  BigInt   @id @default(autoincrement())
  ticket_id           String   @db.VarChar(30)
  assigned_to_user_id String?  @db.VarChar(36)
  assigned_by         String?  @db.VarChar(36)
  assignment_reason   String   @db.VarChar(500)
  escalation_level    Int      @default(1) @db.SmallInt
  assigned_at         DateTime @default(now())
  assigner            users?   @relation("ticket_assignments_assigner", fields: [assigned_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignee            users?   @relation("ticket_assignments_assignee", fields: [assigned_to_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tickets             tickets  @relation(fields: [ticket_id], references: [id], onDelete: Cascade)

  @@index([ticket_id, assigned_at])
  @@index([assigned_to_user_id])
  @@index([assigned_by])
}

model idempotency_keys {
  key           String    @id @db.VarChar(100)
  user_id       String    @db.VarChar(36)
  request_path  String    @db.VarChar(255)
  request_hash  String    @db.VarChar(64)
  status        String    @db.VarChar(20)
  status_code   Int?
  response_body String?   @db.Text
  created_at    DateTime  @default(now())
  expires_at    DateTime?

  @@index([user_id, created_at])
  @@index([status])
}

model system_settings {
  key        String   @id @db.VarChar(100)
  value      String   @db.Text
  updated_by String?  @db.VarChar(100)
  updated_at DateTime @updatedAt
}

model user_sessions {
  id            String    @id @db.VarChar(100)
  user_id       String    @db.VarChar(36)
  jwt_id        String    @db.VarChar(100)
  device_name   String    @db.VarChar(255)
  ip_address    String    @db.VarChar(45)
  is_revoked    Boolean   @default(false)
  last_activity DateTime  @default(now())
  created_at    DateTime  @default(now())
  revoked_at    DateTime?

  @@index([user_id])
  @@index([jwt_id])
}

/// Short-lived tokens issued after successful QR scan.
/// Consumed atomically during ticket creation (used=true via updateMany).
/// TTL: 5 minutes. Cleaned up hourly by qr-session-cleanup cron.
model qr_verification_sessions {
  id            String   @id @default(uuid()) @db.VarChar(36)
  token         String   @unique @db.VarChar(36)
  user_id       String   @db.VarChar(36)
  location_id   Int
  issued_at     DateTime @default(now())
  expires_at    DateTime
  used          Boolean  @default(false)
  created_by_ip String?  @db.VarChar(50)
  device_id     String?  @db.VarChar(100)

  @@index([token])
  @@index([user_id, expires_at])
  @@index([location_id])
  @@index([used])
}

/// System-designated privilege levels for staff.
/// Replaces hardcoded designation strings throughout the codebase.
model designations {
  id               Int      @id @default(autoincrement())
  name             String   @unique(map: "UQ_designations_name") @db.VarChar(100)
  description      String?  @db.VarChar(255)
  /// Users with this designation see ALL tickets (e.g. Admin, Principal, Director, Dean)
  is_privileged    Boolean  @default(false)
  /// Users with this designation act as HODs (Head of Department)
  is_hod           Boolean  @default(false)
  /// Users with this designation can be auto-escalation targets (Level 2, Level 3)
  can_escalate     Boolean  @default(false)
  /// Escalation level this designation maps to (null = not an escalation target)
  escalation_level Int?     @db.SmallInt
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@index([is_privileged])
  @@index([can_escalate])
  @@index([escalation_level])
}

model QR_MASTER {
  Id            Int      @id @default(autoincrement())
  QrNumber      String   @unique(map: "UQ_QR_MASTER_QrNumber") @db.VarChar(50)
  Location      String   @db.VarChar(100)
  Block         String   @db.VarChar(100)
  Floor         String   @db.VarChar(100)
  QrValue       String   @db.VarChar(500)
  PngPath       String   @db.VarChar(500)
  PdfPath       String?  @db.VarChar(500)
  CreatedDate   DateTime @default(now())
  UpdatedDate   DateTime @default(now()) @updatedAt
  Status        String   @default("Active") @db.VarChar(50)
  QrImageBase64 String?  @db.Text
}

enum DepartmentSource {
  LOCATION
  CREATOR
}
