# ============================================================
# CampusConnect Backend — Environment Variables Template
# Copy this file to .env and fill in the real values.
# NEVER commit the actual .env file to version control.
# ============================================================

# -- Database (Supabase PostgreSQL) --
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-SUPABASE-PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# -- JWT --
JWT_SECRET="change-this-to-at-least-32-random-characters"
JWT_ISSUER="CampusConnect"
JWT_AUDIENCE="CampusConnectApp"
JWT_EXPIRES_IN="24h"

# -- Server --
NODE_ENV=production
PORT=3019

# -- CORS --
# Comma-separated list of allowed frontend origins.
# Leave empty to allow all origins (NOT recommended for production).
# Example: CORS_ORIGIN=https://admin.company.com,https://exec.company.com
CORS_ORIGIN=https://admin.company.com,https://exec.company.com

# -- App --
APP_NAME="Campus Connect"
COLLEGE_NAME="Your College Name"
ADMIN_EMAIL="admin@yourcollegedomain.com"

# -- Base URL (used by Flutter mobile app) --
API_URL="https://api.company.com"

# -- College Logo for QR Card Generator --
COLLEGE_LOGO_URL="file://./assets/college-logo.png"

# -- QR Image Base URL --
# Leave empty to serve from /uploads/qrcodes/
QR_IMAGE_BASE_URL=

# -- Google OAuth --
GOOGLE_CLIENT_ID="your-web-client-id.apps.googleusercontent.com"
GOOGLE_ANDROID_CLIENT_ID="your-android-client-id.apps.googleusercontent.com"
GOOGLE_ALLOWED_DOMAIN="yourcollegedomain.ac.in"
GOOGLE_LOGIN_MODE="popup"

# -- Firebase Admin (choose ONE method) --
# Method A: Individual env variables (recommended for production):
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Method B: Place firebase-service-account.json in backend-api/ root.
# (Env variables take priority over the JSON file.)
